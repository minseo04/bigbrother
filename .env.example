# AUTH_SECRET is required in production. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Local file SQLite is used when these are unset (`data/bigbrother.db`).
# On Vercel set both — the filesystem is ephemeral.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canonical public origin for OAuth callbacks (recommended on Vercel).
# AUTH_PUBLIC_URL=https://bigbrother-blue.vercel.app

# Google OAuth. Callback URL: https://<host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional password sign-in. AUTH_USER_ID defaults to `owner`.
# AUTH_PASSWORD=
# AUTH_USER_ID=owner

# Optional GitHub OAuth. Callback URL: https://<host>/api/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
